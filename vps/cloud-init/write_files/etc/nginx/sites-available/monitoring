server {
  listen 8081;
  server_name _;

  # Loki on /loki
  location /loki/ {
    proxy_pass http://127.0.0.1:3100/;  # strip /loki/ prefix
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_buffering off;
    client_max_body_size 10m;

    # Optional CORS if you send logs from a frontend
    # add_header 'Access-Control-Allow-Origin' '*' always;
    # add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
    # add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization' always;
    # if ($request_method = OPTIONS) { return 204; }
  }

  # Prometheus on /prometheus
  # Variant A - if you started Prometheus with --web.route-prefix=/prometheus
  location /prometheus/ {
    proxy_pass http://127.0.0.1:9090/;  # UI already lives under /prometheus
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_redirect off;
  }

  # Variant B - if you do NOT use route-prefix (comment block above and uncomment this)
  # location /prometheus/ {
  #   rewrite ^/prometheus/(.*)$ /$1 break;  # strip prefix
  #   proxy_pass http://127.0.0.1:9090;      # NOTE: no trailing '/' when using rewrite
  #   proxy_http_version 1.1;
  #
  #   proxy_set_header Host $host;
  #   proxy_set_header X-Real-IP $remote_addr;
  #   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  #
  #   proxy_redirect off;
  # }

  location = / {
    add_header Content-Type text/plain;
    return 200 "OK: /prometheus and /loki on port 8081\n";
  }
}
